    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpb2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rb3">
    <!-- update by nishi 2026.7.17
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>     <!-- 摩擦係数を大幅に上げて地面をグリップさせる -->
            <mu2>2.0</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp> <!-- 地面との硬さの剛性 -->
            <kd>10.0</kd>     <!-- ダンピング（跳ね返り防止） -->
          </ode>
        </contact>
      </surface>
    </collision>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <!-- <sensor type="ray" name="lidar"> -->
    <!-- ⬇️ typeを "gpu_lidar" に変更 -->
    <sensor type="gpu_lidar" name="lidar">
      <always_on>true</always_on>
      <!-- <update_rate>30</update_rate> -->
      <update_rate>15</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <!-- ⬇️ Gazebo内で配信するトピック名を明記 -->
      <topic>scan</topic>
      <!-- ⭕ 長い名前を却下し、物理的な取付位置である lidar_link に固定！ -->
      <gz_frame_id>lidar_link</gz_frame_id> 
      <ray>
        <scan>
          <horizontal>
            <samples>1040</samples>
            <resolution>1</resolution>
            <!-- ⬇️ 表記のバグを防ぐため数値を整理（0 から 2*pi） -->
            <min_angle>0.0</min_angle>
            <!-- <max_angle>6.28</max_angle> -->
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>50.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.004</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo> 

  <!-- not use by nishi 2026.7.14
  <gazebo>
    <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
      <body_name>base_link</body_name>
      <frame_name>odom</frame_name>
      <update_rate>10.0</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.01</gaussian_noise>
    </plugin>
  </gazebo>
  -->
  
  <link name="imu_link">
    <inertial>
      <mass value="0.0001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${1e-09 * sim_body_inertia_scale}" ixy="${0.0 * sim_body_inertia_scale}" ixz="${0.0 * sim_body_inertia_scale}" iyy="${1e-09 * sim_body_inertia_scale}" iyz="${0.0 * sim_body_inertia_scale}" izz="${1e-09 * sim_body_inertia_scale}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_controller" type="imu">
      <always_on>true</always_on>
      <!-- <update_rate>50</update_rate> -->
      <update_rate>30</update_rate>
      <!-- ⬇️ Gazebo内で配信するトピック名を明記 -->
      <topic>imu/data</topic>
      <!-- ⭕ 物理的な取付位置である imu_link に固定！ -->
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- 👇 ここから追記・修正項目 -->
      <imu>
        <!-- Orientation (向き) のノイズ・共分散設定 -->
        <!-- 注) 今は、実際は、組み込まれていないみたい。 by nishi 2026.7.18 -->
        <orientation>
          <x><noise type="gaussian"><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.01</stddev></noise></z>
        </orientation>
        <!-- 必要なら角速度(angular_velocity)や加速度(linear_acceleration)も設定可能 -->
        <!--
        <angular_velocity>
          <x><noise type="gaussian"><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.001</stddev></noise></z>
        </angular_velocity> -->
      </imu>
      <!-- 👆 ここまで -->

    </sensor>
  </gazebo>

  <!-- Simulated camera mounted to the front body -->
  <joint name="bodyfront_camera_joint" type="fixed">
    <parent link="Body_front"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
          <box size="0.02 0.02 0.02" />
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ⬇️ ここから新規追加：ROS2の光学ルールに合わせて「前・右・下」に90度ずつひねるリンク -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <!-- RPYで「Z軸を右に90度、X軸を下に90度」ひねる魔法の回転角 -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_optical_link"/>


  <gazebo reference="camera_link">
    <!-- RGBD (カラー + デプスカメラ) を Gazebo Harmonic で有効化する設定 -->
    <sensor type="rgbd_camera" name="sim_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <!-- ⬇️ Gazebo内で配信するトピックベース名 -->
      <topic>camera</topic>
      <!-- ⭕ ここを二箇所とも、ひねった後の optical フレーム名に変更します！ -->
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <optical_frame_id>camera_optical_link</optical_frame_id>
        <horizontal_fov>1.204</horizontal_fov> <!-- 画角 約69度 -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <!-- 深度測定範囲の設定 -->
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <xacro:mini_pupper_ros2_control use_gazebo_hardware="$(arg use_gazebo_hardware)" />

  <!-- Conditional debug support stand -->
  <xacro:if value="$(arg use_debug_stand)">
    <xacro:include filename="$(find mini_pupper_description)/urdf/ros2_control/support_stand.debug.xacro" />
    <xacro:support_stand_debug robot_base_link="base_link"/>
  </xacro:if>

  <!-- add by nihsi 2026.7.15 -->
  <!-- 4足のグリップ力を強制的に引き上げる設定（ファイルの末尾付近に追記） -->
  <gazebo reference="lf3">
    <collision>
      <surface>
        <friction>
          <ode><mu>2.5</mu><mu2>2.5</mu2></ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <!-- <kd>10.0</kd> -->
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rf3">
    <collision>
      <surface>
        <friction>
          <ode><mu>2.5</mu><mu2>2.5</mu2></ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <!-- <kd>10.0</kd> -->
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="lb3">
    <collision>
      <surface>
        <friction>
          <ode><mu>2.5</mu><mu2>2.5</mu2></ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <!-- <kd>10.0</kd> -->
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rb3">
    <collision>
      <surface>
        <friction>
          <ode><mu>2.5</mu><mu2>2.5</mu2></ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <!-- <kd>10.0</kd> -->
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- ⭕ ロボット全体のセンサーシステムプラグイン（ここに1個だけ集約） -->
  <gazebo>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine> <!-- Depthカメラに必須の設定 -->
    </plugin>
  </gazebo>

</robot>