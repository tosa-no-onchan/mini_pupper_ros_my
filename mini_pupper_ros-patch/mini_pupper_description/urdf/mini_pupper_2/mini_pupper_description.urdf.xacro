    <origin xyz="-0.066 0.0235 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lb1"/>
    <axis xyz="1.0 0.0 0.0"/>
    <dynamics damping="${servo_damping}" friction="${servo_friction}"/>
    <limit upper="3.14" lower="-3.14" effort="10.0" velocity="10.47"/>
  </joint>

  <joint name="lb1_lb2" type="revolute">
    <origin xyz="-4E-05 0.0197 0" rpy="0 0 0"/>
    <parent link="lb1"/>
    <child link="lb2"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="${servo_damping}" friction="${servo_friction}"/>
    <limit upper="3.14" lower="-3.14" effort="10.0" velocity="10.47"/>
  </joint>

  <joint name="lb2_lb3" type="revolute">
    <origin xyz="0 0.00475 -0.05" rpy="0 0 0"/>
    <parent link="lb2"/>
    <child link="lb3"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="${servo_damping}" friction="${servo_friction}"/>
    <limit upper="3.14" lower="-3.14" effort="10.0" velocity="10.47"/>
  </joint>

  <joint name="base_front" type="fixed">
    <origin xyz="0.089299 -5e-06 -0.015543" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Body_front"/>
  </joint>

  <joint name="base_board" type="fixed">
    <origin xyz="-0.087701 -0.023505 0.026457" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Board_PCB"/>
  </joint>

  <joint name="base_cn1" type="fixed">
    <origin xyz="0.149035 0.023472 0.0" rpy="0 0 0"/>
    <parent link="Board_PCB"/>
    <child link="Board_connectors_1"/>
  </joint>

  <joint name="base_cn2" type="fixed">
