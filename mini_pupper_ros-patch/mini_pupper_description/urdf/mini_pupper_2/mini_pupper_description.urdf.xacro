<?xml version="1.0" ?>
<robot name="mini_pupper_2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find mini_pupper_description)/urdf/mini_pupper_2/materials.xacro" />
  <!-- Import Mini Pupper ros2_control description -->
  <xacro:include filename="$(find mini_pupper_description)/urdf/ros2_control/mini_pupper.ros2_control.xacro" />
  
  <!-- Arguments -->
  <xacro:arg name="use_gazebo_hardware" default="true"/>
  <xacro:arg name="use_debug_stand" default="false"/>

  <!-- CONSTANTS -->
  <xacro:if value="$(arg use_gazebo_hardware)">
    <!-- Measured passive settled pose in Gazebo with no stand controller loaded. -->
    <xacro:property name="startup_abduction_left" value="-0.33" />
    <xacro:property name="startup_abduction_right" value="0.33" />
    <xacro:property name="startup_hip" value="1.326" />
    <xacro:property name="startup_knee" value="-2.927" />
  </xacro:if>
  <xacro:unless value="$(arg use_gazebo_hardware)">
    <xacro:property name="startup_abduction_left" value="0.0" />
    <xacro:property name="startup_abduction_right" value="0.0" />
    <xacro:property name="startup_hip" value="0.994" />
    <xacro:property name="startup_knee" value="-1.767" />
  </xacro:unless>
  <xacro:property name="foot_mu1" value="1.5" />
  <xacro:property name="foot_mu2" value="1.5" />
  <xacro:property name="foot_kp" value="50000.0" />
  <xacro:property name="foot_kd" value="5.0" />
  <xacro:property name="foot_max_contacts" value="10" />
  <xacro:property name="foot_slip" value="0.0" />

  <!-- Joint dynamics: ODE implicit damping must be small relative to link inertia
       (~2.5e-6 kg·m²). Values above ~0.005 cause ODE to lock joints at origin. -->
  <xacro:if value="$(arg use_gazebo_hardware)">
    <!-- changed by nishi 2027.7.15 -->
    <!-- <xacro:property name="servo_damping" value="0.001" /> -->
    <!-- ダンピングを少し増やして、関節のピチピチ跳ねる暴れを抑える -->
    <!-- <xacro:property name="servo_damping" value="0.05" /> -->
    <xacro:property name="servo_damping" value="0.07" />
    <xacro:property name="servo_friction" value="0.0" />
    <!-- changed by nishi 2027.7.15
    <xacro:property name="sim_inertia_scale" value="100" />
    <xacro:property name="sim_body_inertia_scale" value="100" /> -->
    <!-- 100 から 10（または1）に引き下げて、回転の慣性を正常にします -->
    <xacro:property name="sim_inertia_scale" value="10" />
    <xacro:property name="sim_body_inertia_scale" value="10" />
  </xacro:if>
  <xacro:unless value="$(arg use_gazebo_hardware)">
    <xacro:property name="servo_damping" value="5.0" />
    <xacro:property name="servo_friction" value="1.0" />
    <xacro:property name="sim_inertia_scale" value="1" />
    <xacro:property name="sim_body_inertia_scale" value="1" />
  </xacro:unless>

  <!-- Link group 1 - lf1, rf1, lb1, rb1 -->
  <xacro:property name="lnkgrp1_weight" value="0.020769" />

  <!-- Link group 2 - lf2, rf2, lb2, rb2 -->
  <xacro:property name="lnkgrp2_weight" value="0.001906" />
  
  <!-- Link group 3 - lf3, rf3, lb3, rb3 -->
  <!-- changed by nishi 2026.7.15
  <xacro:property name="lnkgrp3_weight" value="0.001144" /> -->
  <!-- 少なくとも 30グラム（0.03）程度に増やして足に実体を持たせます -->
  <xacro:property name="lnkgrp3_weight" value="0.03" />

  <!-- Plate group 1 - lpf1, rpf1, lpb1, rpb1 -->
  <xacro:property name="pltgrp1_weight" value="0.002574" />
  
  <!-- Plate group 2 - lpf2, rpf2, lpb2, rpb2 -->
  <xacro:property name="pltgrp2_weight" value="0.002231" />

  <!-- Feet - lffoot, rffoot, lbfoot, rbfoot -->
  <xacro:property name="feet_weight" value="0.001405" />
  <!-- -0.004982788451759437 -2.855826620254409e-07 0.006488368014064216 -->
  <!-- COM-Y: 0.00025 -->
  <xacro:property name="feet_centre_of_mass"
                  value="-0.014 0.00025 0.002488" />

  <!-- 1. 最上位フレームとなる base_footprint リンクを定義（物理形状や質量は持たせない空リンク） -->
  <!--
  <link name="base_footprint"/> -->

  <!-- 2. base_footprint(親) と base_link(子) を繋ぐ固定ジョイントを定義 -->
  <!--
  <joint name="base_footprint_to_base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/> -->
    <!-- xyz の z成分（0.07など）で、地面から base_link（胴体中心）までの初期の高さを指定します -->
    <!--
    <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
  </joint> -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.008867 0.000396 -0.007154" rpy="0 0 0"/>
      <!-- chnaged by nishi 2026.7.15
      <mass value="0.174884"/> -->
      <!-- ⬇️ もしここが 0.01 など極端に軽くなっていたら、1.0 (1kg) 程度に変更します -->
      <!-- <mass value="1.0"/> -->
      <mass value="2.0"/>
      <inertia ixx="${0.00090939 * sim_body_inertia_scale}" iyy="${0.00426716 * sim_body_inertia_scale}" izz="${0.00440707 * sim_body_inertia_scale}" ixy="${1.27324e-7 * sim_body_inertia_scale}" iyz="${1.05509e-9 * sim_body_inertia_scale}" ixz="${-1.69927e-7 * sim_body_inertia_scale}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find mini_pupper_description)/meshes/mini_pupper_2/base_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="opaque252525"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find mini_pupper_description)/meshes/mini_pupper_2/base_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="base_inertia">
    <inertial>
      <origin xyz="-0.008867 0.000396 -0.007154" rpy="0 0 0"/>
      <mass value="0.174884"/>
      <inertia ixx="${0.00090939 * sim_body_inertia_scale}" iyy="${0.00426716 * sim_body_inertia_scale}" izz="${0.00440707 * sim_body_inertia_scale}" ixy="${1.27324e-7 * sim_body_inertia_scale}" iyz="${1.05509e-9 * sim_body_inertia_scale}" ixz="${-1.69927e-7 * sim_body_inertia_scale}"/>
    </inertial>
  </link>

  <link name="lf1">
    <inertial>
      <origin xyz="0.020109 0.002332 0.006500" rpy="0 0 0"/>
      <mass value="${lnkgrp1_weight}"/>
      <inertia ixx="${2.494061e-6 * sim_inertia_scale}" iyy="${3.735906e-6 * sim_inertia_scale}" izz="${3.222909e-6 * sim_inertia_scale}" ixy="${-7.662e-9 * sim_inertia_scale}" iyz="${-0.014e-9 * sim_inertia_scale}" ixz="${-33.565e-9 * sim_inertia_scale}"/>
    </inertial>
