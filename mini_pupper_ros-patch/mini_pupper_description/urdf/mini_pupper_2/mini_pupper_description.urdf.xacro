  <joint name="base_sides" type="fixed">
    <origin xyz="-0.002701 -0.030005 -0.016293" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Shell_Side"/>
  </joint>
  <!-- coloring Gazebo model -->
  <gazebo reference="base_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="Board_PCB">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="Body_front">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="Shell_Side">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="Board_connectors_1">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="Board_connectors_2">
    <material>Gazebo/White</material>
  </gazebo>
  
  <gazebo reference="lf1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpf1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lf2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpf2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lf3">
    <!-- upadte by nishi 2026.7.15
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>     <!-- 摩擦係数を大幅に上げて地面をグリップさせる -->
            <mu2>2.0</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp> <!-- 地面との硬さの剛性 -->
            <kd>10.0</kd>     <!-- ダンピング（跳ね返り防止） -->
          </ode>
        </contact>
      </surface>
    </collision>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rf1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpf1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rf2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpf2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rf3">
    <!-- update by nishi 2026.7.17
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2> -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>     <!-- 摩擦係数を大幅に上げて地面をグリップさせる -->
            <mu2>2.0</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
