  <link name="Board_connectors_1">
    <!-- <inertial>
      <origin xyz="-0.07276303117117414 -0.002323344081837562 -0.0010631239213060653" rpy="0 0 0"/>
      <mass value="0.004688613655947816"/>
      <inertia ixx="0.203205e-6" iyy="1.5404404e-5" izz="1.5546403e-5" ixy="-0.625328e-6" iyz="42.901e-9" ixz="0.186346e-9"/>
    </inertial> -->
    <visual>
